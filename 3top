            'F0','V3'
        ]
        
        for p_name in param_check_list:
            if hasattr(P, p_name):
                val = getattr(P, p_name)
                if p_name in vary_list or val != 0.0:
                    out.append(f"  {display_map.get(p_name, p_name):<10} = {format_val_unc(val, get_u(p_name))}")
                
        out.append("-" * 44)
        out.append("3. Derived Moments of Inertia (uA^2)")
        out.append("  Conversion factor: 505379.010 MHz uA^2")
        CONV = 505379.010
        
        Ia = CONV / P.A if P.A else 0.0
        Ib = CONV / P.B if P.B else 0.0
        Ic = CONV / P.C if P.C else 0.0
        
        u_Ia = (CONV / (P.A**2)) * get_u('A') if P.A else 0.0
        u_Ib = (CONV / (P.B**2)) * get_u('B') if P.B else 0.0
        u_Ic = (CONV / (P.C**2)) * get_u('C') if P.C else 0.0
        
        out.append(f"  Ia = {format_val_unc(Ia, u_Ia)}")
        out.append(f"  Ib = {format_val_unc(Ib, u_Ib)}")
        out.append(f"  Ic = {format_val_unc(Ic, u_Ic)}\n")
        
        defect = Ic - Ia - Ib
        u_defect = math.sqrt(u_Ic**2 + u_Ia**2 + u_Ib**2)
        out.append(f"  Inertial Defect (Ic - Ia - Ib) = {format_val_unc(defect, u_defect)} uA^2\n")

    if P.DIAG == 2:
        Xaa = P.Xaa; Xbb = -0.5*P.Xaa + 0.5*P.Xbb_Xcc; Xcc = -0.5*P.Xaa - 0.5*P.Xbb_Xcc
        M = np.array([[Xaa, P.Xab, P.Xac], [P.Xab, Xbb, P.Xbc], [P.Xac, P.Xbc, Xcc]])
        eigenvalues, eigenvectors = np.linalg.eig(M)
        sort_indices = np.argsort(np.abs(eigenvalues))[::-1]
        sorted_evals = eigenvalues[sort_indices]; sorted_evecs = eigenvectors[:, sort_indices]
        Xzz = sorted_evals[0]; Xxx = sorted_evals[1]; Xyy = sorted_evals[2]
        
        def get_eigenval_derivs(vec):
            va, vb, vc = vec
            return np.array([va**2 - 0.5*vb**2 - 0.5*vc**2, 0.5*vb**2 - 0.5*vc**2, 2*va*vb, 2*va*vc, 2*vb*vc])
        
        dXzz_dp = get_eigenval_derivs(sorted_evecs[:, 0])
        dXxx_dp = get_eigenval_derivs(sorted_evecs[:, 1])
        dXyy_dp = get_eigenval_derivs(sorted_evecs[:, 2])
        p_uncs = np.array([get_u('Xaa'), get_u('Xbb_Xcc'), get_u('Xab'), get_u('Xac'), get_u('Xbc')])
        u_Xzz = math.sqrt(np.sum((dXzz_dp * p_uncs)**2))
        u_Xxx = math.sqrt(np.sum((dXxx_dp * p_uncs)**2))
        u_Xyy = math.sqrt(np.sum((dXyy_dp * p_uncs)**2))

        out.append("\n--- Diagonalization of Principal Quadrupole Tensor ---")
        out.append("Matrix M:\n" + str(M))
        out.append(f"Sorted Eigenvalues: {sorted_evals}")
        out.append("-" * 44)
        out.append(f"Xzz = {format_val_unc(Xzz, u_Xzz)}")
        out.append(f"Xxx = {format_val_unc(Xxx, u_Xxx)}")
        out.append(f"Xyy = {format_val_unc(Xyy, u_Xyy)}")
        out.append("-" * 45 + "\n")

    if Run.LINES:
        out.append("\n--- Fitted Transitions & Residuals ---")
        has_spin = (len(P.SPINS) > 0 and sum(P.SPINS) > 1e-5)
        hdr = "          J Ka Kc F      J Ka Kc F      Obs          Calc         Diff        Error      line count" if has_spin else "          J Ka Kc      J Ka Kc      Obs          Calc         Diff        Error      line count"
        out.append(hdr)
        
        for i, ln in enumerate(Run.LINES):
            if has_spin and ln.I1 is not None and ln.F1 is not None:
                su = f"{ln.N1:2d} {ln.K1:1d} {ln.Kp1:1d} {ln.I1:4.1f} {ln.F1:4.1f}"
                sl = f"{ln.N2:2d} {ln.K2:1d} {ln.Kp2:1d} {ln.I2:4.1f} {ln.F2:4.1f}"
            elif has_spin and ln.F1 is not None:
                su = f"{ln.N1:2d} {ln.K1:1d} {ln.Kp1:1d} {ln.F1:4.1f}    "
                sl = f"{ln.N2:2d} {ln.K2:1d} {ln.Kp2:1d} {ln.F2:4.1f}    "
            else:
                su = f"{ln.N1:2d} {ln.K1:1d} {ln.Kp1:1d}         "
                sl = f"{ln.N2:2d} {ln.K2:1d} {ln.Kp2:1d}         "
            out.append(f"   {su}        {sl}            {ln.freq:9.4f}     {ln.calc:9.4f}  {ln.res:10.5f}    {ln.error:.4f}   {i+1}")
            
    with open(filename, 'w') as f: f.write("\n".join(out))
    print(f"\nGenerated {filename} containing requested output (PUB/DIAG and fitted transitions).")

