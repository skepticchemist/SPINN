# 5. Basis Set Generation (Master Router)                             #
# =================================================================== #
def generate_srr_basis_set(J: float, Ka: float, Kc: float, F: float, stat_type: int) -> tuple:
    basis = []
    isym = 2 if (int(Ka) % 2) != 0 else 0
    if Ka + Kc > J: isym += 1
    I1 = P.SPINS[0] if len(P.SPINS) > 0 else 0.0
    I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0
    start_J = int(J) + 2
    end_J = max(0, int(J) - 2)
    for j_val in range(start_J, end_J - 1, -1):
        allowed_I = []
        if F >= 0.0:
            m = I1 + I2
            while m >= abs(I1 - I2):
                if (j_val + m >= F) and (abs(j_val - m) <= F): allowed_I.append(m)
                m -= 1.0
        else: allowed_I = [0.0]
        def get_w(j, i, bt):
            if stat_type == 0: return 1 
            j_even = (j % 2 == 0); i_even = (i % 2 == 0)
            if bt in [0, 2]: al = (j_even and i_even) or (not j_even and not i_even)
            else: al = (j_even and not i_even) or (not j_even and i_even)
            if stat_type == 1: return 1 if al else 0
            elif stat_type == 2: return 0 if al else 1
        for k_val in range(0, j_val + 1, 2):
            for i_val in allowed_I:
                if get_w(j_val, i_val, 0) != 0: basis.append((j_val, k_val, i_val, 0, get_w(j_val, i_val, 0)))
        for k_val in range(2, j_val + 1, 2):
            for i_val in allowed_I:
                if get_w(j_val, i_val, 1) != 0: basis.append((j_val, k_val, i_val, 1, get_w(j_val, i_val, 1)))
        for k_val in range(1, j_val + 1, 2):
            for i_val in allowed_I:
                if get_w(j_val, i_val, 2) != 0: basis.append((j_val, k_val, i_val, 2, get_w(j_val, i_val, 2)))
        for k_val in range(3, j_val + 1, 2):
            for i_val in allowed_I:
                if get_w(j_val, i_val, 3) != 0: basis.append((j_val, k_val, i_val, 3, get_w(j_val, i_val, 3)))
    return basis, isym

def generate_radical_basis_set(N: float, Ka: float, Kc: float, F_tot: float, stat_type: int) -> tuple:
    basis = []
    isym = 2 if (int(Ka) % 2) != 0 else 0
    if Ka + Kc > N: isym += 1
    S = getattr(P, 'S', 0.5) 
    I1 = P.SPINS[0] if len(P.SPINS) > 0 else 0.0
    I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0
    I3 = P.SPINS[2] if len(P.SPINS) > 2 else 0.0
    start_N = int(N) + 2
    end_N = max(0, int(N) - 2)
    for n_val in range(start_N, end_N - 1, -1):
        for j_val in [n_val + S, abs(n_val - S)]:
            for f1_val in np.arange(j_val + I1, abs(j_val - I1) - 1, -1):
                for f2_val in np.arange(f1_val + I2, abs(f1_val - I2) - 1, -1):
                    for f_final in np.arange(f2_val + I3, abs(f2_val - I3) - 1, -1):
                        if F_tot >= 0.0 and f_final != F_tot: continue
                        for k_val in range(0, n_val + 1, 2): basis.append((n_val, j_val, f1_val, f2_val, f_final, k_val, 0, 1.0))
                        for k_val in range(2, n_val + 1, 2): basis.append((n_val, j_val, f1_val, f2_val, f_final, k_val, 1, 1.0))
                        for k_val in range(1, n_val + 1, 2): basis.append((n_val, j_val, f1_val, f2_val, f_final, k_val, 2, 1.0))
                        for k_val in range(3, n_val + 1, 2): basis.append((n_val, j_val, f1_val, f2_val, f_final, k_val, 3, 1.0))
    return basis, isym

def generate_3spin_basis_set(J: float, Ka: float, Kc: float, F_tot: float, stat_type: int) -> tuple:
    basis = []
    isym = 2 if (int(Ka) % 2) != 0 else 0
    if Ka + Kc > J: isym += 1
    I1 = P.SPINS[0] if len(P.SPINS) > 0 else 0.0
    I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0
    I3 = P.SPINS[2] if len(P.SPINS) > 2 else 0.0
    start_J = int(J) + 2; end_J = max(0, int(J) - 2)
    for j_val in range(start_J, end_J - 1, -1):
        for f1_val in np.arange(j_val + I1, abs(j_val - I1) - 1, -1):
            for f2_val in np.arange(f1_val + I2, abs(f1_val - I2) - 1, -1):
                for f_final in np.arange(f2_val + I3, abs(f2_val - I3) - 1, -1):
                    if F_tot >= 0.0 and f_final != F_tot: continue
                    for k_val in range(0, j_val + 1, 2): basis.append((j_val, f1_val, f2_val, f_final, k_val, 0, 1.0))
                    for k_val in range(2, j_val + 1, 2): basis.append((j_val, f1_val, f2_val, f_final, k_val, 1, 1.0))
                    for k_val in range(1, j_val + 1, 2): basis.append((j_val, f1_val, f2_val, f_final, k_val, 2, 1.0))
                    for k_val in range(3, j_val + 1, 2): basis.append((j_val, f1_val, f2_val, f_final, k_val, 3, 1.0))
    return basis, isym

def generate_basis_set(J_or_N: float, Ka: float, Kc: float, F_tot: float, stat_type: int) -> tuple:
    if getattr(P, 'FORMAT', 'SRR') == 'SRR': return generate_srr_basis_set(J_or_N, Ka, Kc, F_tot, stat_type)
    elif P.FORMAT == 'SR': return generate_radical_basis_set(J_or_N, Ka, Kc, F_tot, stat_type)
    elif P.FORMAT == '3SPIN': return generate_3spin_basis_set(J_or_N, Ka, Kc, F_tot, stat_type)
    else: return generate_srr_basis_set(J_or_N, Ka, Kc, F_tot, stat_type)

