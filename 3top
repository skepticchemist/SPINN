# 6. Hamiltonian Math Engines (SR and 3SPIN)                          #
# =================================================================== #
def get_asym_top_rot(N, K1, K2):
    if N < 0: return 0.0
    if K1 == K2: return P.A * K1**2 + 0.5 * (P.B + P.C) * (N * (N + 1) - K1**2)
    elif abs(K1 - K2) == 2: return 0.25 * (P.B - P.C) * math.sqrt((N - max(K1, K2) + 1) * (N - max(K1, K2) + 2) * (N + max(K1, K2) - 1) * (N + max(K1, K2)))
    return 0.0

def calc_spin_rotation_element(N1, K1, J1, N2, K2, J2, S):
    if J1 != J2: return 0.0
    eps_0 = -(1.0 / math.sqrt(3.0)) * (P.Eaa + P.Ebb + P.Ecc)
    eps_20 = (1.0 / math.sqrt(6.0)) * (2.0 * P.Eaa - P.Ebb - P.Ecc)
    eps_22 = 0.5 * (P.Ebb - P.Ecc)
    S_mag = math.sqrt(S * (S + 1) * (2 * S + 1))
    phase1 = (-1)**(N1 + J1 + S)
    w6j = wigner6j(N1, S, J1, S, N2, 1)
    if abs(w6j) < 1e-12: return 0.0
    prefactor = phase1 * w6j * S_mag * math.sqrt((2 * N1 + 1) * (2 * N2 + 1))
    sum_terms = 0.0
    if N1 == N2 and K1 == K2:
        w3j_0 = wigner3j(N1, 0, N2, -K1, 0, K2)
        if abs(w3j_0) > 1e-12: sum_terms += ((-1)**(N1 - K1)) * w3j_0 * eps_0 * math.sqrt(N1 * (N1 + 1) * (2 * N1 + 1))
    if abs(N1 - N2) <= 2:
        if K1 == K2:
            w3j_20 = wigner3j(N1, 2, N2, -K1, 0, K2)
            if abs(w3j_20) > 1e-12: sum_terms += ((-1)**(N1 - K1)) * w3j_20 * eps_20 * 1.5 
        if abs(K1 - K2) == 2:
            w3j_22 = wigner3j(N1, 2, N2, -K1, K1 - K2, K2)
            if abs(w3j_22) > 1e-12: sum_terms += ((-1)**(N1 - K1)) * w3j_22 * eps_22 * 1.5
    return prefactor * sum_terms

def calc_J_V1_J(N1, K1, J1, N2, K2, J2, S, aF, Taa, Tbb_Tcc):
    fermi_val = 0.0
    if N1 == N2 and K1 == K2:
        w6j = wigner6j(S, J1, N1, J2, S, 1)
        if abs(w6j) > 1e-12:
            fermi_val = aF * ((-1)**(N1 + S + J2 + 1)) * math.sqrt((2*J1+1)*(2*J2+1)) * w6j * math.sqrt(S*(S+1)*(2*S+1))
    dipole_val = 0.0
    if abs(N1 - N2) <= 2:
        red_T2 = 0.0
        phase_N = (-1)**(N1 - K1)
        prefac_N = math.sqrt((2*N1+1)*(2*N2+1))
        if K1 == K2:
            w3j = wigner3j(N1, 2, N2, -K1, 0, K2)
            if abs(w3j) > 1e-12: red_T2 += phase_N * prefac_N * w3j * Taa
        elif abs(K1 - K2) == 2:
            w3j = wigner3j(N1, 2, N2, -K1, K1 - K2, K2)
            if abs(w3j) > 1e-12: red_T2 += phase_N * prefac_N * w3j * (Tbb_Tcc / math.sqrt(6.0))
        if abs(red_T2) > 1e-12:
            w9j = wigner9j(N1, S, J1, N2, S, J2, 2, 1, 1)
            if abs(w9j) > 1e-12:
                dipole_val = math.sqrt(3.0) * math.sqrt((2*J1+1)*(2*J2+1)) * w9j * red_T2 * math.sqrt(S*(S+1)*(2*S+1))
    return fermi_val + dipole_val

def calc_Q_rot(j1, k1, j2, k2, Xaa, Xbb_Xcc):
    if abs(j1 - j2) > 2: return 0.0
    C0_0 = Xaa / 2.0; C2_0 = Xaa / 2.0; C2_2 = Xbb_Xcc / 4.0
    val = 0.0
    if k1 == k2:
        t0 = C0_0 * wigner3j(j1, 0.0, j2, -k1, 0, k2) if j1 == j2 else 0.0
        t2 = C2_0 * wigner3j(j1, 2.0, j2, -k1, 0, k2)
        val = t0 + t2
    elif abs(k1 - k2) == 2:
        val = C2_2 * wigner3j(j1, 2.0, j2, -k1, k1 - k2, k2)
    return val * math.sqrt((2.0*j1+1)*(2.0*j2+1))

def build_3spin_hamiltonian(basis, isym):
    dim = len(basis)
    H_tot = np.zeros((dim, dim), dtype=complex)
    I1 = P.SPINS[0] if len(P.SPINS) > 0 else 0.0
    I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0
    I3 = P.SPINS[2] if len(P.SPINS) > 2 else 0.0

    for i in range(dim):
        j1, f1_1, f2_1, f_1, k1, sym1, w1 = basis[i] 
        for j in range(dim):
            j2, f1_2, f2_2, f_2, k2, sym2, w2 = basis[j]
            if f_1 != f_2: continue

            if j1 == j2 and f1_1 == f1_2 and f2_1 == f2_2:
                rot_val = get_asym_top_rot(j1, k1, k2)
                if k1 == k2: H_tot[i, j] += rot_val
                elif abs(k1 - k2) == 2:
                    if k1 == 0 or k2 == 0: H_tot[i, j] += rot_val * math.sqrt(2.0)
                    else: H_tot[i, j] += rot_val

            if I1 > 0 and f2_1 == f2_2:
                R1 = calc_Q_rot(j1, k1, j2, k2, P.Xaa, P.Xbb_Xcc)
                if abs(R1) > 1e-12:
                    if abs(k1 - k2) == 2 and (k1 == 0 or k2 == 0): R1 *= math.sqrt(2.0)
                    w6 = wigner6j(I1, j1, f1_1, j2, I1, 2.0)
                    H_tot[i, j] += ((-1)**(I1 + j2 + f1_1)) * w6 * R1

            if I2 > 0 and f1_1 != 0 and f1_2 != 0:
                R2 = calc_Q_rot(j1, k1, j2, k2, getattr(P, 'Xaa2', 0.0), getattr(P, 'Xbb_Xcc2', 0.0))
                if abs(R2) > 1e-12:
                    if abs(k1 - k2) == 2 and (k1 == 0 or k2 == 0): R2 *= math.sqrt(2.0)
                    red_F1 = ((-1)**(j1 + I1 + f1_2)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 2.0) * R2
                    w6 = wigner6j(I2, f1_1, f2_1, f1_2, I2, 2.0)
                    H_tot[i, j] += ((-1)**(I2 + f1_2 + f2_1)) * w6 * red_F1

            if I3 > 0 and f1_1 != 0 and f1_2 != 0 and f2_1 != 0 and f2_2 != 0:
                R3 = calc_Q_rot(j1, k1, j2, k2, getattr(P, 'Xaa3', 0.0), getattr(P, 'Xbb_Xcc3', 0.0))
                if abs(R3) > 1e-12:
                    if abs(k1 - k2) == 2 and (k1 == 0 or k2 == 0): R3 *= math.sqrt(2.0)
                    red_F1 = ((-1)**(j1 + I1 + f1_2)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 2.0) * R3
                    red_F2 = ((-1)**(f1_1 + I2 + f2_2)) * math.sqrt((2*f2_1+1)*(2*f2_2+1)) * wigner6j(f1_1, f2_1, I2, f2_2, f1_2, 2.0) * red_F1
                    w6 = wigner6j(I3, f2_1, f_1, f2_2, I3, 2.0)
                    H_tot[i, j] += ((-1)**(I3 + f2_2 + f_1)) * w6 * red_F2
    return H_tot

def build_radical_hamiltonian(basis, isym):
    dim = len(basis)
    H_tot = np.zeros((dim, dim), dtype=complex)
    S = getattr(P, 'S', 0.5)
    I1 = P.SPINS[0] if len(P.SPINS) > 0 else 0.0
    I2 = P.SPINS[1] if len(P.SPINS) > 1 else 0.0
    I3 = P.SPINS[2] if len(P.SPINS) > 2 else 0.0
    def I_mag(I_val): return math.sqrt(I_val*(I_val+1)*(2*I_val+1)) if I_val > 0 else 0.0

    for i in range(dim):
        n1, j1, f1_1, f2_1, f_1, k1, sym1, w1 = basis[i]
        for j in range(dim):
            n2, j2, f1_2, f2_2, f_2, k2, sym2, w2 = basis[j]
            if f_1 != f_2: continue # Diagonal in F
            if j1 == j2 and f1_1 == f1_2 and f2_1 == f2_2:
                rot_val = get_asym_top_rot(n1, k1, k2)
                if k1 == k2 and n1 == n2: H_tot[i, j] += rot_val
                elif abs(k1 - k2) == 2 and n1 == n2:
                    if k1 == 0 or k2 == 0: H_tot[i, j] += rot_val * math.sqrt(2.0)
                    else: H_tot[i, j] += rot_val
            if f1_1 == f1_2 and f2_1 == f2_2:
                H_tot[i, j] += calc_spin_rotation_element(n1, k1, j1, n2, k2, j2, S)
            red_V1_s1 = calc_J_V1_J(n1, k1, j1, n2, k2, j2, S, P.AF, P.TAA, P.TBB_TCC)
            red_V1_s2 = calc_J_V1_J(n1, k1, j1, n2, k2, j2, S, P.AF2, P.TAA2, P.TBB_TCC2)
            red_V1_s3 = calc_J_V1_J(n1, k1, j1, n2, k2, j2, S, P.AF3, P.TAA3, P.TBB_TCC3)
            if I1 > 0 and f2_1 == f2_2 and abs(red_V1_s1) > 1e-12:
                w6j = wigner6j(j1, I1, f1_1, I1, j2, 1)
                H_tot[i, j] += ((-1)**(j2 + I1 + f1_1)) * w6j * red_V1_s1 * I_mag(I1)
            if I2 > 0 and f1_1 != 0 and f1_2 != 0 and abs(red_V1_s2) > 1e-12:
                red_F1 = ((-1)**(j1 + I1 + f1_2 + 1)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 1) * red_V1_s2
                if abs(red_F1) > 1e-12:
                    H_tot[i, j] += ((-1)**(f1_2 + I2 + f2_1)) * wigner6j(f1_1, I2, f2_1, I2, f1_2, 1) * red_F1 * I_mag(I2)
            if I3 > 0 and f1_1 != 0 and f1_2 != 0 and f2_1 != 0 and f2_2 != 0 and abs(red_V1_s3) > 1e-12:
                red_F1 = ((-1)**(j1 + I1 + f1_2 + 1)) * math.sqrt((2*f1_1+1)*(2*f1_2+1)) * wigner6j(j1, f1_1, I1, f1_2, j2, 1) * red_V1_s3
                if abs(red_F1) > 1e-12:
                    red_F2 = ((-1)**(f1_1 + I2 + f2_2 + 1)) * math.sqrt((2*f2_1+1)*(2*f2_2+1)) * wigner6j(f1_1, f2_1, I2, f2_2, f1_2, 1) * red_F1
                    if abs(red_F2) > 1e-12:
                        H_tot[i, j] += ((-1)**(f2_2 + I3 + f_1)) * wigner6j(f2_1, I3, f_1, I3, f2_2, 1) * red_F2 * I_mag(I3)
    return H_tot

def build_ir_hamiltonian(basis, isym):
    if len(basis) == 0: return np.array([])
    J = basis[0][0] 
    sigma = isym  
    H_rot, K_vals = build_rot_hamiltonian(J) 
    vt_max = getattr(P, 'VT_MAX', 5) 
    dim_rot = int(2 * J + 1); dim_tot = dim_rot * vt_max
    H_total = np.zeros((dim_tot, dim_tot), dtype=complex)
    tor_energies = {}; tor_evecs = {}
    for K in K_vals:
        evals, evecs = solve_1d_torsion_iam(sigma, K, getattr(P, 'F', 0.0), getattr(P, 'V3', 0.0), getattr(P, 'RHO_a', 0.0))
        tor_energies[K] = evals[:vt_max]; tor_evecs[K] = evecs[:, :vt_max] 
        
    for i, K1 in enumerate(K_vals):
        for j, K2 in enumerate(K_vals):
            rot_val = H_rot[i, j]
            if abs(rot_val) < 1e-12 and i != j: continue
            overlap = tor_evecs[K1].T @ tor_evecs[K2]
            row_start = i * vt_max; col_start = j * vt_max
            H_total[row_start:row_start+vt_max, col_start:col_start+vt_max] += rot_val * overlap
            if i == j: H_total[row_start:row_start+vt_max, col_start:col_start+vt_max] += np.diag(tor_energies[K1])
    return H_total

def build_hamiltonian(basis, isym):
    current_format = getattr(P, 'FORMAT', 'SRR')
    if current_format == 'SR': return build_radical_hamiltonian(basis, isym)
    elif current_format == '3SPIN': return build_3spin_hamiltonian(basis, isym)
    elif current_format == 'IR': return build_ir_hamiltonian(basis, isym)
    return np.zeros((0,0)) # Fallback, SRR handled explicitly in solver

