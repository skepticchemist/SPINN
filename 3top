# 7. Solver and Energy Levels                                         #
# =================================================================== #
def calculate_internal_rotor_constants():
    CONV = 505379.010  
    if P.F0 > 1e-9: P.I_ALPHA = CONV / (P.F0 * 1000.0)
    else: P.I_ALPHA = 0.0
    Ia = CONV / P.A if P.A > 1e-9 else 1e10
    Ib = CONV / P.B if P.B > 1e-9 else 1e10
    Ic = CONV / P.C if P.C > 1e-9 else 1e10
    delta_rad = math.radians(getattr(P, 'DELTA', 0.0))
    epsilon_rad = math.radians(getattr(P, 'EPSILON', 0.0))
    la = math.cos(delta_rad)
    lb = math.sin(delta_rad) * math.cos(epsilon_rad)
    lc = math.sin(delta_rad) * math.sin(epsilon_rad)
    P.RHO_a = la * (P.I_ALPHA / Ia)
    P.RHO_b = lb * (P.I_ALPHA / Ib)
    rho_c = lc * (P.I_ALPHA / Ic)
    r = 1.0 - (P.RHO_a * la + P.RHO_b * lb + rho_c * lc)
    if r > 1e-9: P.F = P.F0 / r
    else: P.F = 0.0

def solve_energy_levels(Jmax, sigma=0):
    calculate_internal_rotor_constants()
    rot_levels = {}
    has_spin = len(P.SPINS) > 0 and sum(P.SPINS) > 1e-5
    
    for J in range(Jmax + 3):
        # -------------------------------------------------------------
        # EXACT RIGID ROTOR MAPPING (Guarantees zero-spin SRR accuracy)
        # -------------------------------------------------------------
        if P.FORMAT == 'SRR' and not has_spin:
            H, _ = build_rot_hamiltonian(J)
            w = np.linalg.eigvalsh(H)
            w = np.sort(w) # Sorts strictly from lowest E to highest E
            
            # Map theoretical pseudo-quantum numbers (Prolate: A > B ~ C)
            Ka_arr = [0]; Kc_arr = [J]
            for k in range(1, J+1):
                Ka_arr.extend([k, k])
                Kc_arr.extend([J-k+1, J-k])
                
            rot_levels[J] = []
            for i in range(2*J + 1):
                rot_levels[J].append({'J': J, 'Ka': Ka_arr[i], 'Kc': Kc_arr[i], 'E': w[i], 'hfs': []})
            continue

        # -------------------------------------------------------------
        # HYPERFINE / RADICAL / IR MATRICES
        # -------------------------------------------------------------
        basis, _ = generate_basis_set(J, 0, J, -1.0, P.STATISTICS)
        if not basis: continue
        
        H_tot = build_hamiltonian(basis, sigma)
        if len(H_tot) == 0: continue
        
        w, v = np.linalg.eigh(H_tot)
        idx_sort = np.argsort(w)
        w = w[idx_sort]; v = v[:, idx_sort]
        
        rot_levels[J] = []
        for i in range(len(w)):
            energy = w[i]
            vec = v[:, i]
            dom_idx = np.argmax(np.abs(vec))
            b_state = basis[dom_idx]
            
            if P.FORMAT == 'IR':
                vt = dom_idx // (2*J + 1)
                state = {'J': J, 'E': energy, 'vec': vec, 'Ka': 0, 'Kc': 0, 'vt': vt, 'hfs': [{'E': energy, 'F': J}]}
                rot_levels[J].append(state)
                
            elif P.FORMAT == 'SR':
                n_val, j_val, f1_val, f2_val, f_final, k_val, sym, wgt = b_state
                Ka = k_val; Kc = n_val - Ka
                state = {'J': n_val, 'E': energy, 'vec': vec, 'Ka': Ka, 'Kc': Kc, 'vt': 0,
                         'hfs': [{'E': energy, 'J_rad': j_val, 'F1': f1_val, 'F2': f2_val, 'F': f_final}]}
                rot_levels[J].append(state)
                
            elif P.FORMAT == '3SPIN':
                j_val, f1_val, f2_val, f_final, k_val, sym, wgt = b_state
                Ka = k_val; Kc = j_val - Ka
                state = {'J': j_val, 'E': energy, 'vec': vec, 'Ka': Ka, 'Kc': Kc, 'vt': 0,
                         'hfs': [{'E': energy, 'F1': f1_val, 'F2': f2_val, 'F': f_final}]}
                rot_levels[J].append(state)

            else:
                j_val, k_val, i_val, b_type, wgt = b_state
                Ka = k_val; Kc = j_val - Ka
                state = {'J': j_val, 'E': energy, 'vec': vec, 'Ka': Ka, 'Kc': Kc, 'vt': 0,
                         'hfs': [{'E': energy, 'F': j_val, 'I': i_val}]}
                rot_levels[J].append(state)
                
    return rot_levels

# =================================================================== #
# 8. Fitter Core                                                      #
# =================================================================== #
def run_fit(vary_list):
    print(f"--- Matrix Fit (Numerical Differentiation) ---")
    p_vec = np.array([getattr(P, p) for p in vary_list])
    
    def get_residuals(curr_params):
        for p, val in zip(vary_list, curr_params): setattr(P, p, val)
        needed_J = max([max(ln.N1, ln.N2) for ln in Run.LINES]) if Run.LINES else 0
        levels = solve_energy_levels(needed_J, sigma=0)
        resids = []
        has_spin = len(P.SPINS) > 0 and sum(P.SPINS) > 1e-5
        
        for ln in Run.LINES:
            try:
                # Accurately isolate the exact state by mapping Ka and Kc directly to the level dictionary
                u_cand = [s for s in levels.get(ln.N1, []) if s['Ka'] == ln.K1 and s['Kc'] == ln.Kp1]
                l_cand = [s for s in levels.get(ln.N2, []) if s['Ka'] == ln.K2 and s['Kc'] == ln.Kp2]
                
                if has_spin and ln.F1 is not None:
                    u_cand = [s for s in u_cand if any(abs(h['F'] - ln.F1) < 0.1 for h in s.get('hfs', []))]
                    l_cand = [s for s in l_cand if any(abs(h['F'] - ln.F2) < 0.1 for h in s.get('hfs', []))]
                
                if u_cand and l_cand:
                    calc_f = u_cand[0]['E'] - l_cand[0]['E']
                else:
                    calc_f = 0.0 # Will flag as a miss if the quantum number isn't found
                    
                ln.calc = calc_f
                ln.res = ln.freq - calc_f
                resids.append(ln.res)
            except Exception as e:
                resids.append(ln.freq)
        return np.array(resids)

    # Calculate initial residual and start iterations
    r0 = get_residuals(p_vec)
    for cycle in range(1, Run.NCY + 1):
        rms = np.sqrt(np.mean(r0**2))
        print(f" Iteration {cycle:2d} ... RMS: {rms:12.6f} MHz")
        
        jac = []
        step = P.FDIF
        for i, p_name in enumerate(vary_list):
            p_save = p_vec[i]
            p_vec[i] += step
            r_plus = get_residuals(p_vec)
            p_vec[i] = p_save
            jac.append((r0 - r_plus) / step)
            
        Jac = np.array(jac).T
        W = np.diag([ln.weight for ln in Run.LINES])
        JtW = Jac.T @ W
        Alpha = JtW @ Jac + np.eye(len(p_vec)) * P.DUMP
        Beta = JtW @ r0
        
        try: delta_p = np.linalg.solve(Alpha, Beta)
        except: delta_p = np.linalg.pinv(Alpha) @ Beta
        
        # --- CONVERGENCE CHECKS ---
        # 1. Stop if the parameter shifts are practically zero
        if np.max(np.abs(delta_p)) < 1e-8:
            print(" Converged! Parameter shifts are negligible.")
            break
            
        p_vec += delta_p
        r0 = get_residuals(p_vec)
        new_rms = np.sqrt(np.mean(r0**2))
        
        # 2. Stop if the change in RMS is smaller than your FTH threshold
        if abs(rms - new_rms) < P.FTH:
            print(f" Biggie smalls is content! She will not push your cup of tea off the table!")
            break
        
    # --- Final Uncertainty Calculation ---
    # Recalculate Jacobian at the optimized parameters to get the final covariance matrix
    jac = []
    step = P.FDIF
    for i, p_name in enumerate(vary_list):
        p_save = p_vec[i]
        p_vec[i] += step
        r_plus = get_residuals(p_vec)
        p_vec[i] = p_save
        jac.append((r0 - r_plus) / step)
        
    Jac = np.array(jac).T
    W_list = [ln.weight for ln in Run.LINES]
    W = np.diag(W_list)
    JtW = Jac.T @ W
    Hessian = JtW @ Jac
    
    try:
        cov = np.linalg.inv(Hessian)
    except np.linalg.LinAlgError:
        cov = np.linalg.pinv(Hessian)
        
    # Degrees of freedom (N points - M parameters)
    N = len(Run.LINES)
    M = len(vary_list)
    dof = max(1, N - M)
    
    # Sum of squared weighted residuals (Chi-Squared)
    chi2 = np.sum(W_list * (r0**2))
    reduced_chi2 = chi2 / dof
    
    # Formal parameter uncertainties: sqrt(Diagonal_Elements_of_Covariance * Reduced_Chi2)
    unc = np.sqrt(np.abs(np.diag(cov)) * reduced_chi2)
    
    rms_raw = np.sqrt(np.mean(r0**2))
    rms_w = np.sqrt(chi2 / N)
    
    print(f" Final RMS: {rms_raw:12.6f} MHz")
    
    # --- THE CRITICAL FIX ---
    # Restore the transitions back to the optimal parameters before writing to the file!
    _ = get_residuals(p_vec)
        
    return p_vec, unc, chi2, rms_w, rms_raw
