# 4. Math Engines: Base Rotational Matrices                           #
# =================================================================== #
def build_matrices(J):
    dim = int(2*J + 1)
    K_vals = np.arange(-J, J+1)
    Jz = np.diag(K_vals)
    Jp = np.zeros((dim, dim), dtype=complex)
    Jm = np.zeros((dim, dim), dtype=complex)
    for i, K in enumerate(K_vals):
        if i+1 < dim: Jp[i+1, i] = math.sqrt((J - K)*(J + K + 1))
        if i-1 >= 0:  Jm[i-1, i] = math.sqrt((J + K)*(J - K + 1))
    Jx = 0.5 * (Jp + Jm)
    Jy = -0.5j * (Jp - Jm)
    return Jx, Jy, Jz, K_vals

def build_rot_hamiltonian(J):
    Jx, Jy, Jz, K_vals = build_matrices(J)
    if getattr(P, 'REP', 'IIIr') == 'IIIr': Ja, Jb, Jc = Jx, Jy, Jz 
    else: Ja, Jb, Jc = Jz, Jx, Jy 
    Ja2 = Ja @ Ja; Jb2 = Jb @ Jb; Jc2 = Jc @ Jc
    J2  = Ja2 + Jb2 + Jc2 
    H = P.A * Ja2 + P.B * Jb2 + P.C * Jc2
    
    if getattr(P, 'REDUCTION', 'A') == 'A':
        H += -P.DJ * (J2 @ J2) - P.DJK * (J2 @ Jz @ Jz) - P.DK * (Jz @ Jz @ Jz @ Jz)
        if abs(getattr(P, 'dJ', 0.0)) > 1e-20: H += -2.0 * P.dJ * (J2 @ (Jx @ Jx - Jy @ Jy))
        if abs(getattr(P, 'dK', 0.0)) > 1e-20: H += -P.dK * (Jz @ Jz @ (Jx @ Jx - Jy @ Jy) + (Jx @ Jx - Jy @ Jy) @ Jz @ Jz)
    elif getattr(P, 'REDUCTION', 'A') == 'S':
        H += -P.DJ * (J2 @ J2) - P.DJK * (J2 @ Jz @ Jz) - P.DK * (Jz @ Jz @ Jz @ Jz)
        Jp = Jx + 1j * Jy; Jm = Jx - 1j * Jy; Jp2 = Jp @ Jp; Jm2 = Jm @ Jm
        if abs(getattr(P, 'd1', 0.0)) > 1e-20: H += P.d1 * (J2 @ (Jp2 + Jm2))
        if abs(getattr(P, 'd2', 0.0)) > 1e-20: H += P.d2 * (Jp2 @ Jp2 + Jm2 @ Jm2)
    return H, K_vals

def solve_1d_torsion_iam(sigma, K, F, V3, rho, m_max=15, fold=3):
    k_vals = np.arange(-m_max, m_max + 1)
    m_vals = fold * k_vals + sigma
    dim = len(k_vals)
    H_tor = np.zeros((dim, dim))
    for i in range(dim):
        H_tor[i, i] = F * ((m_vals[i] - rho * K)**2)
        if i + 1 < dim: H_tor[i, i+1] = -V3 / 4.0
        if i - 1 >= 0:  H_tor[i, i-1] = -V3 / 4.0
    return np.linalg.eigh(H_tor)

