                                        if len(P.SPINS) >= 3:
                                            qu = f"{u['J']:2d} {u['Ka']:2d} {u['Kc']:2d} {u_hfs.get('F1',0):4.1f} {u_hfs.get('F2',0):4.1f} {u_hfs.get('F',0):4.1f}"
                                            ql = f"{l['J']:2d} {l['Ka']:2d} {l['Kc']:2d} {l_hfs.get('F1',0):4.1f} {l_hfs.get('F2',0):4.1f} {l_hfs.get('F',0):4.1f}"
                                        elif len(P.SPINS) == 2:
                                            qu = f"{u['J']:2d} {u['Ka']:2d} {u['Kc']:2d} {u_hfs.get('F1',0):4.1f} {u_hfs.get('F',0):4.1f}"
                                            ql = f"{l['J']:2d} {l['Ka']:2d} {l['Kc']:2d} {l_hfs.get('F1',0):4.1f} {l_hfs.get('F',0):4.1f}"
                                        else:
                                            qu = f"{u['J']:2d} {u['Ka']:2d} {u['Kc']:2d} {u_hfs.get('F',0):4.1f}"
                                            ql = f"{l['J']:2d} {l['Ka']:2d} {l['Kc']:2d} {l_hfs.get('F',0):4.1f}"
                                    else:
                                        if len(P.SPINS) > 1:
                                            qu = f"{u['J']:2d} {u['Ka']:2d} {u['Kc']:2d} {u_hfs.get('I', 0.0):4.1f} {u_hfs['F']:4.1f}"
                                            ql = f"{l['J']:2d} {l['Ka']:2d} {l['Kc']:2d} {l_hfs.get('I', 0.0):4.1f} {l_hfs['F']:4.1f}"
                                        else:
                                            qu = f"{u['J']:2d} {u['Ka']:2d} {u['Kc']:2d} {u_hfs['F']:4.1f}"
                                            ql = f"{l['J']:2d} {l['Ka']:2d} {l['Kc']:2d} {l_hfs['F']:4.1f}"
                                    
                                    trans.append({'f': freq, 'i_abs': inten, 'qs': f"{qu}   {ql}{label_tag}"})
                        else:
                            freq = u['E'] - l['E']
                            if freq < P.FMIN or freq > P.FMAX: continue
                            boltz = math.exp(-l['E']/kT) - math.exp(-u['E']/kT)
                            inten = freq * mu2 * boltz
                            if inten <= 1e-30: continue
                            trans.append({'f': freq, 'i_abs': inten, 'qs': f"{u['J']:2d} {u['Ka']:2d} {u['Kc']:2d}   {l['J']:2d} {l['Ka']:2d} {l['Kc']:2d}{label_tag}"})

    if trans:
        max_i = max(t['i_abs'] for t in trans)
        for t in trans: t['i'] = math.log10(t['i_abs']/max_i + 1e-20)
    trans.sort(key=lambda x: x['f'])
    
    with open(filename, 'w') as f:
        now = datetime.datetime.now()
        f.write(f"{now.strftime('%H:%M:%S')}         MONTH={now.month}  DAY={now.day}  {now.year}\n")
        
        if P.FORMAT == 'SR':
            if len(P.SPINS) >= 3: f.write(f"Frequency      LogInt    N Ka Kc J F1 F2 F      (Up - Low)\n")
            elif len(P.SPINS) == 2: f.write(f"Frequency      LogInt    N Ka Kc J F1 F         (Up - Low)\n")
            elif len(P.SPINS) == 1: f.write(f"Frequency      LogInt    N Ka Kc J F            (Up - Low)\n")
            else: f.write(f"Frequency      LogInt    N Ka Kc J              (Up - Low)\n")
        elif P.FORMAT == '3SPIN':
            if len(P.SPINS) >= 3: f.write(f"Frequency      LogInt    J Ka Kc F1 F2 F        (Up - Low)\n")
            elif len(P.SPINS) == 2: f.write(f"Frequency      LogInt    J Ka Kc F1 F           (Up - Low)\n")
            else: f.write(f"Frequency      LogInt    J Ka Kc F              (Up - Low)\n")
        else:
            if has_spin and len(P.SPINS) > 1: f.write(f"Frequency      LogInt    J Ka Kc   I    F       (Up - Low)\n")
            elif has_spin: f.write(f"Frequency      LogInt    J Ka Kc   F            (Up - Low)\n")
            else: f.write(f"Frequency      LogInt    J Ka Kc                (Up - Low)\n")
            
        f.write("-------------------------------------------------------\n")
        for t in trans: f.write(f"   {t['f']:9.4f}       {t['i']:7.4f}    {t['qs']}\n")

def main():
    in_file = "3top_input.txt"
    if len(sys.argv) > 1: in_file = sys.argv[1]
    parse_input(in_file)
    vary_list = [p for p, v, f in Run.VARY if f == 2]
    
    if vary_list and Run.LINES:
        p_vec, unc, rss, rms_w, rms_raw = run_fit(vary_list)
        write_pred_file(in_file.replace('.txt','.pred'), vary_list, p_vec, unc, rss, rms_w, rms_raw)
        if P.PUBL == 2: write_publ_file(in_file.replace('.txt','.publ'), vary_list, p_vec, unc, rms_raw)
    else:
        write_pred_file(in_file.replace('.txt','.pred'), [], [], [], 0, 0, 0)
        if P.PUBL == 2: write_publ_file(in_file.replace('.txt','.publ'), [], [], [], 0.0)
            
    write_freq_file(in_file.replace('.txt','.freq'))

if __name__ == "__main__":
    main()
