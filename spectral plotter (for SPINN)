    def auto_baseline_analyze(self):
        """Advanced ALS Baseline + Smoothing"""
        if len(self.top_y) == 0: return
        smoothed = apply_hanning_filter(self.top_y)
        baseline = asymmetric_least_squares(smoothed)
        self.ax.plot(self.top_x, baseline / np.max(self.top_y), "r--", alpha=0.5, label="Baseline")
        self.canvas.draw()

    def open_loomis_woods(self):
        """Generates a Loomis-Woods plot in a new window based on a user-defined spacing."""
        if len(self.top_x) == 0:
            messagebox.showwarning("No Data", "Please load experimental data (Top) first.")
            return

        spacing = simpledialog.askfloat("Loomis-Woods Spacing", 
                                        "Enter the expected spacing (e.g., 2B) in MHz:\n(Example: 2500.5)",
                                        parent=self, minvalue=0.1)
        if not spacing: return 

        prominence_thresh = self.prom_slider.get() / 100.0
        norm_y = self.top_y / np.max(self.top_y)
        peaks_indices, _ = find_peaks(norm_y, prominence=prominence_thresh)
        
        if len(peaks_indices) == 0:
            messagebox.showinfo("No Peaks", "No peaks found at current sensitivity. Lower the threshold.")
            return

        peak_freqs = self.top_x[peaks_indices]
        peak_ints = norm_y[peaks_indices]

        start_freq = peak_freqs[0]
        lw_x = (peak_freqs - start_freq) % spacing 
        lw_y = (peak_freqs - start_freq) // spacing 

        lw_window = tk.Toplevel(self)
        lw_window.title(f"Loomis-Woods Plot (Spacing: {spacing} MHz)")
        lw_window.geometry("800x600")

        fig = Figure(figsize=(7, 5), dpi=100)
        ax = fig.add_subplot(111)
        scatter = ax.scatter(lw_x, lw_y, c=peak_ints, s=peak_ints*100, cmap='viridis', alpha=0.8, edgecolors='none')
        
        ax.set_xlabel(f"Frequency mod {spacing} (MHz)")
        ax.set_ylabel("Segment Index (m)")
        ax.set_title(f"Loomis-Woods Analysis")
        ax.grid(True, linestyle='--', alpha=0.5)
        fig.colorbar(scatter, ax=ax, label="Relative Intensity")

        canvas = FigureCanvasTkAgg(fig, master=lw_window)
        canvas.draw()
        canvas.get_tk_widget().pack(side=tk.TOP, fill=tk.BOTH, expand=True)
        toolbar = NavigationToolbar2Tk(canvas, lw_window)
        toolbar.update()

    def predict_j_plus_1(self):
        """Predicts the next transitions in a rigid rotor band based on a starting frequency and J+1"""
        default_freq = ""
        if len(self.selected_freqs) > 0:
            default_freq = f"{self.selected_freqs[-1]:.4f}"

        freq_str = simpledialog.askstring("Starting Frequency", 
                                          "Enter the frequency of the line (MHz):",
                                          initialvalue=default_freq, parent=self)
        if not freq_str: return
        
        j_str = simpledialog.askinteger("Input J+1", 
                                        "Enter the (J+1) integer value for this line:", 
                                        parent=self, minvalue=1)
        if not j_str: return
        
        try:
            freq = float(freq_str)
            j_plus_1 = int(j_str)
        except ValueError:
            messagebox.showerror("Error", "Invalid number entered.")
            return
            
        two_B = freq / j_plus_1
        
        self.log_list.insert(tk.END, "")
        self.log_list.insert(tk.END, f"=== PREDICTED J+1 BAND (Calculated 2B = {two_B:.4f} MHz) ===")
        
        for i in range(1, 9):
            next_j_plus_1 = j_plus_1 + i
            next_freq = two_B * next_j_plus_1
            
            line = self.ax.axvline(x=next_freq, color='magenta', linestyle='-.', linewidth=1.5, alpha=0.8)
            self.selections.append(line)
            
            t = self.ax.text(next_freq, 0.95, f"J+1={next_j_plus_1}", rotation=90, color="magenta", 
                             verticalalignment='top', backgroundcolor='white', transform=self.ax.get_xaxis_transform())
            self.selections.append(t)
            
            self.log_list.insert(tk.END, f"Predicted J+1={next_j_plus_1} : {next_freq:.4f} MHz")
            
        current_xmin, current_xmax = self.ax.get_xlim()
        max_pred = two_B * (j_plus_1 + 8)
        min_pred = two_B * (j_plus_1 + 1)
        self.ax.set_xlim(min(current_xmin, min_pred - 100), max(current_xmax, max_pred + 100))
        
        self.log_list.yview(tk.END)
        self.canvas.draw()

    def find_all_zoomed_pairs(self):
        """Finds peaks and intelligently determines if they are single lines or pairs"""
        if len(self.top_x) == 0: return
        
        try:
            prominence_thresh = self.prom_slider.get() / 100.0
            split_threshold = float(self.max_split_var.get())
        except ValueError: return
        
        x_min, x_max = self.ax.get_xlim()
        mask = (self.top_x >= x_min) & (self.top_x <= x_max)
        if not np.any(mask): return
        
        # ---> FIX: Use local maximum so small peaks in zoomed area are found! <---
        local_max = np.max(self.top_y[mask]) 
        if local_max == 0: local_max = 1
        
        x_zoomed, y_zoomed = self.top_x[mask], self.top_y[mask] / local_max
        peaks_indices, _ = find_peaks(y_zoomed, prominence=prominence_thresh)
        
        found_freqs = x_zoomed[peaks_indices]
        found_y = y_zoomed[peaks_indices]
        
        i = 0
        while i < len(found_freqs):
            f1 = found_freqs[i]
            
            # Check if there is a next peak AND if it falls within the Doppler split threshold
            if i + 1 < len(found_freqs) and abs(found_freqs[i+1] - f1) <= split_threshold:
                # Pair detected
                f2 = found_freqs[i+1]
                center = (f1 + f2) / 2.0
                split = abs(f1 - f2)
                
                line = self.ax.axvline(x=center, color='purple', linestyle='--', alpha=0.8)
                self.selections.append(line)
                
                log_entry = f"AUTO Pair   | Center: {center:.4f} | Split: {split:.4f}"
                self.log_list.insert(tk.END, log_entry)
                self.log_list.yview(tk.END)
                
                self.peak_data.append({
                    "Type": "Auto Pair", 
                    "Center_Frequency_MHz": round(center, 5),
                    "Relative_Intensity": round(float((found_y[i] + found_y[i+1])/2.0), 5), 
                    "Doppler_Split_MHz": round(split, 5)
                })
                i += 2 
            else:
                # Single line detected
                line = self.ax.axvline(x=f1, color='orange', linestyle=':', alpha=0.8)
                self.selections.append(line)
                
                log_entry = f"AUTO Single | Freq:   {f1:.4f}"
                self.log_list.insert(tk.END, log_entry)
                self.log_list.yview(tk.END)
                
                self.peak_data.append({
                    "Type": "Auto Single", 
                    "Center_Frequency_MHz": round(f1, 5),
                    "Relative_Intensity": round(float(found_y[i]), 5), 
                    "Doppler_Split_MHz": 0.0
                })
                i += 1 
                
        self.canvas.draw()

    # ---------------------------------------------------------
    # PATTERN-AWARE AUTO-ASSIGNMENT LOGIC
    # ---------------------------------------------------------
    def auto_assign(self):
        if not self.peak_data:
            self.log_list.insert(tk.END, "ERROR: Find experimental peaks first!")
            self.log_list.yview(tk.END)
            return
            
        fname = filedialog.askopenfilename(
            title="Select Predicted File (.freq or .pred)", 
            filetypes=[("Prediction Files", "*.freq *.pred"), ("All Files", "*.*")]
        )
        if not fname: return
        
        try: tolerance = float(self.assign_tol_var.get())
        except ValueError:
            self.log_list.insert(tk.END, "ERROR: Invalid Assign Tolerance!")
            return

        predictions = []
        try:
            with open(fname, 'r') as f:
                for line in f:
                    parts = line.split()
                    if not parts: continue
                    floats = []
                    for p in parts:
                        try: floats.append(float(p))
                        except ValueError: pass
                    freq_candidates = [x for x in floats if x > 1000]
                    if freq_candidates:
                        freq = freq_candidates[0]
                        predictions.append({'freq': freq, 'full_line': line.strip()})
        except Exception as e:
            self.log_list.insert(tk.END, f"Failed to read file: {e}")
            return

        if not predictions:
            self.log_list.insert(tk.END, "Could not find valid frequencies inside that file!")
            return

        exp_freqs = sorted([p['Center_Frequency_MHz'] for p in self.peak_data])
        min_exp = min(exp_freqs)
        max_exp = max(exp_freqs)
        
        MAX_GLOBAL_SHIFT = 150.0 
        local_preds = [p for p in predictions if (min_exp - MAX_GLOBAL_SHIFT) <= p['freq'] <= (max_exp + MAX_GLOBAL_SHIFT)]
        
        if not local_preds:
            self.log_list.insert(tk.END, f"ERROR: No predicted lines found within {MAX_GLOBAL_SHIFT} MHz of your peaks.")
            self.log_list.yview(tk.END)
            return

        best_shift = 0.0
        best_matches = []
        max_match_count = 0
        best_error_sum = float('inf')

        try:
            for exp_f in exp_freqs:
                for pred_p in local_preds:
                    test_shift = exp_f - pred_p['freq']
                    current_matches = []
                    error_sum = 0.0
                    available_preds = list(local_preds) 
                    
                    for e_f in exp_freqs:
                        best_local_diff = float('inf')
                        best_local_match = None
                        
                        for ap in available_preds:
                            shifted_p_freq = ap['freq'] + test_shift
                            diff = abs(e_f - shifted_p_freq)
                            
                            if diff <= tolerance and diff < best_local_diff:
                                best_local_diff = diff
                                best_local_match = ap
                                
                        if best_local_match:
                            current_matches.append({
                                'exp': e_f,
                                'pred': best_local_match,
                                'diff': e_f - best_local_match['freq'] 
                            })
                            available_preds.remove(best_local_match) 
                            error_sum += best_local_diff
                            
                    if len(current_matches) > max_match_count:
                        max_match_count = len(current_matches)
                        best_matches = current_matches
                        best_shift = test_shift
                        best_error_sum = error_sum
                    elif len(current_matches) == max_match_count and len(current_matches) > 0:
                        if error_sum < best_error_sum:
                            best_matches = current_matches
                            best_shift = test_shift
                            best_error_sum = error_sum
        except Exception as e:
            self.log_list.insert(tk.END, f"Calculation Error: {e}")
            self.log_list.yview(tk.END)
            return

        self.log_list.insert(tk.END, "")
        self.log_list.insert(tk.END, f"=== PATTERN ASSIGNMENT (Tol: {tolerance} MHz) ===")
        
        if max_match_count == 0:
            self.log_list.insert(tk.END, "No overlapping patterns found.")
            self.log_list.insert(tk.END, "="*55)
            self.log_list.yview(tk.END)
            return

        self.log_list.insert(tk.END, f"Found Pattern! Recognized Global Shift: {best_shift:+.4f} MHz")
        self.log_list.insert(tk.END, f"Matched {max_match_count} out of {len(exp_freqs)} experimental peaks.")
        
        export_lines = []
        export_lines.append(f"# Pattern-Assigned Predictions")
        export_lines.append(f"# Tolerance: {tolerance} MHz | Recognized Global Shift: {best_shift:+.4f} MHz")
        export_lines.append(f"# Obs_Freq(MHz)    Calc_Freq(MHz)    O-C_Diff    Original_Prediction_Line")
        export_lines.append("-" * 85)

        best_matches.sort(key=lambda x: x['exp'])

        for m in best_matches:
            exp_freq = m['exp']
            pred = m['pred']
            diff_val = m['diff']
            self.log_list.insert(tk.END, f"MATCH -> Obs: {exp_freq:.4f} | Calc: {pred['freq']:.4f} | O-C: {diff_val:+.4f}")
            export_line = f"{exp_freq:.4f}    {pred['freq']:.4f}    {diff_val:+.4f}    {pred['full_line']}"
            export_lines.append(export_line)

        save_name = filedialog.asksaveasfilename(
            title="Save Pattern Assignments",
            defaultextension=".pred",
            filetypes=[("Assigned Prediction File", "*.pred"), ("Frequency File", "*.freq"), ("Text File", "*.txt")]
        )
        if save_name:
            try:
                with open(save_name, 'w') as f:
                    f.write("\n".join(export_lines))
                self.log_list.insert(tk.END, f">>> SUCCESS: Saved {max_match_count} pattern matches.")
            except Exception as e:
                self.log_list.insert(tk.END, f"ERROR saving file: {e}")
                
        self.log_list.insert(tk.END, "="*55)
        self.log_list.yview(tk.END)

    # ---------------------------------------------------------
    # MULTI-FORMAT EXPORT 
    # ---------------------------------------------------------
    def export_peaks_data(self):
        if len(self.peak_data) == 0: return
        fname = filedialog.asksaveasfilename(
            defaultextension=".dat", 
            filetypes=[("PGOPHER Stick Data", "*.dat"), ("CSV File", "*.csv"), ("Detailed Text", "*.txt"), ("JSON File", "*.json")]
        )
        if not fname: return

        try:
            ext = os.path.splitext(fname)[1].lower()
            sorted_peaks = sorted(self.peak_data, key=lambda row: float(row['Center_Frequency_MHz']))

            if ext == '.csv':
                with open(fname, mode='w', newline='', encoding='utf-8') as file:
                    writer = csv.DictWriter(file, fieldnames=["Type", "Center_Frequency_MHz", "Relative_Intensity", "Doppler_Split_MHz"])
                    writer.writeheader()
                    for row in sorted_peaks: writer.writerow(row)
            elif ext == '.txt':
                with open(fname, mode='w', encoding='utf-8') as file:
                    file.write(f"{'Type':<18} {'Center (MHz)':<15} {'Intensity':<12} {'Split (MHz)':<12}\n")
                    file.write("-" * 60 + "\n")
                    for row in sorted_peaks:
                        file.write(f"{row['Type']:<18} {row['Center_Frequency_MHz']:<15} {row['Relative_Intensity']:<12} {row['Doppler_Split_MHz']:<12}\n")
            elif ext == '.dat':
                with open(fname, mode='w', encoding='utf-8') as file:
                    for row in sorted_peaks:
                        freq = round(float(row['Center_Frequency_MHz']), 3)
                        intensity = row['Relative_Intensity']
                        if intensity == "N/A": intensity = 1.000
                        else: intensity = float(intensity)
                        file.write(f"{freq - 0.001:.3f} 0.000\n")
                        file.write(f"{freq:.3f} {intensity:.5f}\n")
                        file.write(f"{freq + 0.001:.3f} 0.000\n")
            elif ext == '.json':
                with open(fname, mode='w', encoding='utf-8') as file:
                    json.dump(sorted_peaks, file, indent=4)
        except Exception as e: print(f"Failed to export data: {e}")

