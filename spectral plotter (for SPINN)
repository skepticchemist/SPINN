    def load_top(self):
        fname = filedialog.askopenfilename(title="Select Experimental File", filetypes=[("Waveform Files", "*.wfm"), ("All Files", "*.*")])
        if fname:
            x, y = parse_file_content(fname)
            if len(x) > 0:
                self.top_x, self.top_y = x, y
                self.lbl_info.config(text=f"Loaded Top: {os.path.basename(fname)} ({len(x)} pts)")
                self.update_info_panel(fname, x) 
                self.redraw_plot()
                if fname.lower().endswith('.wfm'):
                    self.log_list.insert(tk.END, f"[WFM Loaded] Automatically aligned X-axis for {os.path.basename(fname)}")
                    self.log_list.yview(tk.END)

    def update_info_panel(self, fname, x):
        if len(x) == 0: return
        self.info_labels["File"].config(text=os.path.basename(fname))
        self.info_labels["Data Points"].config(text=f"{len(x):,}")
        self.info_labels["Start Freq"].config(text=f"{np.min(x):.4f} MHz")
        self.info_labels["Stop Freq"].config(text=f"{np.max(x):.4f} MHz")
        
        step = abs(x[1] - x[0]) if len(x) > 1 else 0
        self.info_labels["Step Size"].config(text=f"{step:.6f} MHz")
        
        shots = "Unknown"
        par_path = os.path.splitext(fname)[0] + ".par"
        if os.path.exists(par_path):
            try:
                with open(par_path, 'r') as p:
                    lines = [line.strip() for line in p.readlines() if line.strip()]
                    if len(lines) >= 4: shots = lines[3] 
                    elif len(lines) == 3: shots = lines[2]
            except Exception: pass
            
        self.info_labels["Shots / Avg"].config(text=shots)

    def export_exp_to_dat(self):
        if len(self.top_x) == 0:
            self.log_list.insert(tk.END, "ERROR: No Experimental Data loaded to convert.")
            self.log_list.yview(tk.END)
            return
            
        fname = filedialog.asksaveasfilename(
            title="Convert and Save as .dat",
            defaultextension=".dat", 
            filetypes=[("DAT Data", "*.dat")]
        )
        if not fname: return
        
        try:
            df = pd.DataFrame({"Frequency_X": self.top_x, "Intensity_Y": self.top_y})
            df = df.sort_values(by="Frequency_X").drop_duplicates(subset="Frequency_X").reset_index(drop=True)
            df["Frequency_X"] = df["Frequency_X"].map('{:.6f}'.format)
            df.to_csv(fname, sep='\t', index=False)
            
            self.log_list.insert(tk.END, f">>> SUCCESS: Saved converted experimental data to {os.path.basename(fname)}")
            self.log_list.yview(tk.END)
        except Exception as e:
            self.log_list.insert(tk.END, f"ERROR converting file: {e}")
            self.log_list.yview(tk.END)

    def load_bot(self):
        fname = filedialog.askopenfilename(title="Select Prediction File", filetypes=[("All Files", "*.*"), ("CAT files", "*.cat")])
        if fname:
            x, y = parse_file_content(fname)
            if len(x) > 0:
                self.bot_x, self.bot_y = x, y
                self.lbl_info.config(text=f"Loaded Bot: {os.path.basename(fname)} ({len(x)} pts)")
                self.redraw_plot()

    def redraw_plot(self):
        self.ax.clear()
        
        if len(self.top_x) > 0:
            y_norm = self.top_y / np.max(self.top_y)
            self.ax.plot(self.top_x, y_norm, color="black", lw=1.0, label="Experimental")
            
        if len(self.bot_x) > 0:
            max_y = np.max(self.bot_y) if np.max(self.bot_y) != 0 else 1
            y_norm = self.bot_y / max_y
            
            if self.pred_state == 0:     
                baseline, mult = 0.0, -1.0
                self.current_ymin = -1.1
            elif self.pred_state == 1:   
                baseline, mult = 0.0, 1.0
                self.current_ymin = -0.1
            else:                        
                baseline, mult = -1.1, 1.0
                self.current_ymin = -2.2
            
            y_scaled = mult * y_norm
            ymin = np.minimum(baseline, baseline + y_scaled)
            ymax = np.maximum(baseline, baseline + y_scaled)
            self.ax.vlines(self.bot_x, ymin, ymax, color="red", linewidth=1.2)
            
            if self.pred_state == 2:
                self.ax.axhline(baseline, color='gray', linewidth=0.8, linestyle=':')
        else:
            self.current_ymin = -0.1
            
        self.current_ymax = 1.1
        self.ax.set_ylim(self.current_ymin, self.current_ymax)

        self.ax.axhline(0, color='gray', linewidth=0.8)
        self.ax.grid(True, linestyle="--", alpha=0.3)
        self.ax.set_xlabel("Frequency (MHz)")
        
        # ---> FORCE PLAIN NUMBERS ON X-AXIS DURING REDRAW <---
        self.ax.ticklabel_format(useOffset=False, style='plain', axis='x')
        
        self.canvas.draw()

    def toggle_pred_dir(self):
        self.pred_state = (self.pred_state + 1) % 3
        modes = ["Butterfly", "Overlap", "Stacked"]
        self.btn_toggle.config(text=f"Pred View: {modes[self.pred_state]}")
        self.redraw_plot()

    # ---------------------------------------------------------
    # INTENSITY SCALING LOGIC 
    # ---------------------------------------------------------
    def inc_exp(self):
        self.current_ymax /= 1.5
        self.ax.set_ylim(self.current_ymin, self.current_ymax)
        self.canvas.draw()

    def dec_exp(self):
        self.current_ymax *= 1.5
        self.ax.set_ylim(self.current_ymin, self.current_ymax)
        self.canvas.draw()

    def inc_pred(self):
        self.current_ymin /= 1.5
        self.ax.set_ylim(self.current_ymin, self.current_ymax)
        self.canvas.draw()

    def dec_pred(self):
        self.current_ymin *= 1.5
        self.ax.set_ylim(self.current_ymin, self.current_ymax)
        self.canvas.draw()

    def reset_scales(self):
        self.current_ymax = 1.1
        if self.pred_state == 0: self.current_ymin = -1.1
        elif self.pred_state == 1: self.current_ymin = -0.1
        else: self.current_ymin = -2.2
        self.ax.set_ylim(self.current_ymin, self.current_ymax)
        self.canvas.draw()

