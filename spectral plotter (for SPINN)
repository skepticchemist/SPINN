# ROBUST DATA READER (NOW WITH WFM INTEGRATION)
# -----------------------------------------------------------------------------
def parse_file_content(filename):
    x_list, y_list = [], []
    is_log_scale = False
    if not filename: return np.array([]), np.array([])
    
    try:
        # 1. LabVIEW .wfm Binary Format Integration
        if filename.lower().endswith('.wfm'):
            folder_path = os.path.dirname(filename)
            base_name = os.path.splitext(os.path.basename(filename))[0]
            par_file_path = os.path.join(folder_path, base_name + ".par")
            
            par_start, par_stop = None, None
            if os.path.exists(par_file_path):
                with open(par_file_path, 'r') as p:
                    lines = [line.strip() for line in p.readlines() if line.strip()]
                    if len(lines) >= 2:
                        par_start = float(lines[0])
                        par_stop = float(lines[1])

            with open(filename, 'rb') as f:
                raw_bytes = f.read()

            arrays_found = []
            array_starts = []
            i = 0
            while i < len(raw_bytes) - 8:
                N = struct.unpack('>i', raw_bytes[i:i+4])[0]
                if 10 < N < 10000000 and i + 4 + (N * 8) <= len(raw_bytes):
                    first_float = struct.unpack('>d', raw_bytes[i+4:i+12])[0]
                    if np.isfinite(first_float) and abs(first_float) < 1e15:
                        floats = np.frombuffer(raw_bytes[i+4 : i+4+(N*8)], dtype='>f8')
                        if np.sum(np.isfinite(floats) & (np.abs(floats) < 1e15)) == N:
                            arrays_found.append(floats)
                            array_starts.append(i)
                            i += 4 + (N * 8)
                            continue
                i += 1

            for idx in range(len(arrays_found)):
                Y_chunk = arrays_found[idx]
                array_start = array_starts[idx]
                N_points = len(Y_chunk)
                
                true_t0, true_dt = None, None
                try:
                    true_dt = struct.unpack('>d', raw_bytes[array_start-8 : array_start])[0]
                    sec, frac = struct.unpack('>qQ', raw_bytes[array_start-24 : array_start-8])
                    true_t0 = sec + (frac / (2**64))
                except Exception:
                    pass

                if true_t0 is not None and true_dt is not None and true_dt > 0:
                    X_chunk = true_t0 + (np.arange(N_points) * true_dt)
                    x_list.extend(X_chunk)
                    y_list.extend(Y_chunk)
                elif par_start is not None and par_stop is not None and len(arrays_found) == 1:
                    exact_step = (par_stop - par_start) / N_points
                    X_chunk = par_start + (np.arange(N_points) * exact_step)
                    x_list.extend(X_chunk)
                    y_list.extend(Y_chunk)

            if len(x_list) > 0:
                df = pd.DataFrame({"X": x_list, "Y": y_list})
                df = df.sort_values(by="X").drop_duplicates(subset="X").reset_index(drop=True)
                return df["X"].to_numpy(), df["Y"].to_numpy()
            return np.array([]), np.array([])

        # 2. SPCAT .cat file format (Log base 10 intensity in column 3)
        elif filename.lower().endswith('.cat'):
            with open(filename, 'r', errors='ignore') as f:
                for line in f:
                    parts = line.split()
                    if len(parts) >= 3:
                        try:
                            freq = float(parts[0])
                            log_int = float(parts[2]) 
                            x_list.append(freq)
                            y_list.append(10 ** log_int)  
                        except ValueError:
                            continue
            return np.array(x_list), np.array(y_list)

        # 3. .freq file format (Strictly read as-is, NO scaling)
        elif filename.lower().endswith(('.freq', '.pred')):
            with open(filename, 'r', errors='ignore') as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith('#'): continue
                    parts = line.replace(',', ' ').split()
                    if len(parts) >= 2:
                        try:
                            x_list.append(float(parts[0]))
                            y_list.append(float(parts[1]))
                        except ValueError:
                            continue
            return np.array(x_list), np.array(y_list)

        # 4. Standard file fallback
        else:
            with open(filename, 'r', errors='ignore') as f:
                lines = f.readlines()
                for line in lines[:20]:
                    if "LogInt" in line or "Log Int" in line:
                        is_log_scale = True
                        break
                for line in lines:
                    line = line.strip()
                    if not line: continue 
                    parts = line.replace(',', ' ').split()
                    if len(parts) < 2: continue
                    try:
                        x_list.append(float(parts[0]))
                        y_list.append(float(parts[1]))
                    except ValueError:
                        continue
    except Exception as e:
        print(f"Error reading file: {e}")
        return np.array([]), np.array([])

    x_arr, y_arr = np.array(x_list), np.array(y_list)
    if is_log_scale and len(y_arr) > 0:
        try: y_arr = 10.0 ** y_arr
        except: pass
        
    return x_arr, y_arr

